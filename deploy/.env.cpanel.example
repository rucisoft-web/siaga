# ================================================================
#  SIAGA — .env produksi cPanel
#  Salin: cp deploy/.env.cpanel.example .env   lalu isi bagian bertanda <<ISI>>
# ================================================================
APP_NAME="SIAGA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# <<ISI>> alamat aplikasi, HARUS https dan sama persis dengan yang dibuka di browser
APP_URL=https://asset.namahotel.com
APP_TIMEZONE=UTC
ASSETCARE_DISPLAY_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# <<ISI>> dari MySQL Database Wizard (berawalan nama akun cPanel)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_siaga
DB_USERNAME=cpuser_siaga
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# <<ISI>> akun email pengirim (cPanel › Email Accounts › Connect Devices)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.namahotel.com
MAIL_PORT=465
MAIL_USERNAME=noreply@namahotel.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@namahotel.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- SIAGA
# Nama hotel, kode, logo, warna & zona waktu diisi saat instalasi lalu diubah di Pengaturan › Profil hotel.
ASSETCARE_BRAND_NAME="SIAGA"
ASSETCARE_DEMO_EMAIL_DOMAIN=hotel.test
ASSETCARE_AUDIT_ENABLED=true
# <<ISI>> domain yang TERCETAK PERMANEN di label QR. Tentukan sebelum cetak massal.
# Kosong = APP_URL. Contoh: https://asset.namahotel.com
ASSETCARE_QR_BASE_URL=
ASSETCARE_QR_EXTRA_HOSTS=
# Wajibkan 2FA untuk administrator & penyetuju
ASSETCARE_MFA_REQUIRED=true
# Hari libur kalender kerja SLA P3/P4 (YYYY-MM-DD,YYYY-MM-DD)
ASSETCARE_HOLIDAYS=
ASSETCARE_NOTIFY_MAIL=true
# Data contoh tidak dipasang saat instalasi. Pasang terpisah bila perlu: bash deploy/deploy-cpanel.sh demo
ASSETCARE_SEED_DEMO=false
# Hanya untuk impor SQL/seed manual: sandi Super Admin awal (kosong = acak, ditampilkan sekali)
ASSETCARE_ADMIN_PASSWORD=
