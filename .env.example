APP_NAME="GPCH Asset Care"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://asset-care-gpch.test
# Timestamp disimpan dalam UTC; tampilan dan tanggal operasional memakai Asia/Jakarta
APP_TIMEZONE=UTC
ASSETCARE_DISPLAY_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- MySQL 8.4 LTS (bawaan Laragon: user root, tanpa kata sandi)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=asset_care_gpch
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# produksi (HTTPS): SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="assetcare@grandpasundanhotel.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- GPCH Asset Care
ASSETCARE_BRAND_NAME="GPCH Asset Care"
ASSETCARE_PROPERTY_CODE=GPCH
ASSETCARE_AUDIT_ENABLED=true
# Domain resolver label QR (https://asset.grandpasundanhotel.com). Kosong = APP_URL.
ASSETCARE_QR_BASE_URL=
# Host lain yang diterima pembaca QR, pisahkan koma
ASSETCARE_QR_EXTRA_HOSTS=
# Wajibkan 2FA untuk administrator & approver
ASSETCARE_MFA_REQUIRED=false
# Hari libur kalender kerja SLA P3/P4 (YYYY-MM-DD,YYYY-MM-DD)
ASSETCARE_HOLIDAYS=
# Kirim notifikasi juga lewat email (butuh MAIL_* yang benar)
ASSETCARE_NOTIFY_MAIL=false
# Muat data contoh (kamar pilot, template Deluxe, akun jabatan) walau APP_ENV=production
ASSETCARE_SEED_DEMO=false
